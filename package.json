{
  "name": "fyshuffle",
  "version": "0.9.2",
  "type": "module",
  "main": "./dist/FYShuffle.node.cjs",
  "module": "./dist/FYShuffle.module.js",
  "browser": "./dist/FYShuffle.js",
  "types": "./dist/FYShuffle.d.ts",
  "bin": {
    "fyshuffle": "./bin/fyshuffle.js"
  },
  "exports": {
    "import": {
      "types": "./dist/FYShuffle.d.ts",
      "default": "./dist/FYShuffle.module.js"
    },
    "require": {
      "types": "./dist/FYShuffle.d.ts",
      "default": "./dist/FYShuffle.node.cjs"
    }
  },
  "scripts": {
    "test": "node --test",
    "tsgen": "tsc -p tsconfig.build.json",
    "types": "dts-bundle-generator --project tsconfig.dts.json -o dist/FYShuffle.d.ts ts/FYShuffle.module.d.ts",
    "build": "node scripts/build.js && npm run tsgen && npm run types",
    "build:release": "node scripts/build.js --release && npm run tsgen && npm run types"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "dts-bundle-generator": "^9.5.1",
    "prettier": "^3.6.2",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "undici-types": "^7.11.0"
  },
  "files": [
    "dist/FYShuffle-dev.js",
    "dist/FYShuffle.v0.9.2-dev.js",
    "dist/FYShuffle.node.cjs",
    "dist/FYShuffle.node.v0.9.2-dev.cjs",
    "dist/FYShuffle.module.js",
    "dist/FYShuffle.module.v0.9.2-dev.js",
    "dist/FYShuffle.d.ts",
    "dist/manifest.json",
    "dist/README.md",
    "dist/LICENSE",
    "bin/fyshuffle.js"
  ]
}
